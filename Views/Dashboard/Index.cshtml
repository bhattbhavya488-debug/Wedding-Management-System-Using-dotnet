@model WeddingManagementSystem.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard - Royal Knot";
}

<div class="py-5" style="background: linear-gradient(135deg, #fdf2f4, #fff9f0); border-bottom: 1px solid rgba(197, 155, 39, 0.2);">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge badge-gold px-3 py-1 mb-2">Welcome Back</span>
                <h1 class="display-6 fw-bold mb-1">Hello, @Model.User.FullName!</h1>
                <p class="text-muted small mb-0">Manage your wedding reservations, ceremony details, and invoices from your personal dashboard.</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Packages" asp-action="Index" class="btn btn-royal">
                    <i class="bi bi-gift me-1"></i> Browse Packages
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Stat Widgets -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-royal">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalBookings</div>
                    <div class="text-muted small">Total Bookings</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-gold">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.PendingBookings</div>
                    <div class="text-muted small">Pending Verification</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-green">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.ConfirmedBookings</div>
                    <div class="text-muted small">Confirmed Weddings</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-blue">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-truncate">₹@Model.TotalSpent.ToString("N0")</div>
                    <div class="text-muted small">Total Investment</div>
                </div>
            </div>
        </div>
    </div>

    <!-- My Bookings Section -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-calendar2-heart text-danger me-2"></i> My Wedding Reservations</h5>
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary btn-sm">View All</a>
                </div>

                @if (!Model.Bookings.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-calendar-plus display-4 mb-3 text-secondary"></i>
                        <h5>No reservations made yet</h5>
                        <p class="small">Choose a package to reserve your wedding date and services.</p>
                        <a asp-controller="Packages" asp-action="Index" class="btn btn-royal btn-sm">Explore Packages</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small">
                                <tr>
                                    <th class="ps-4">Booking #</th>
                                    <th>Package</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Bookings.Take(5))
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-danger">@b.BookingNumber</td>
                                        <td>
                                            <div class="fw-semibold">@(b.Package?.Name ?? "Package")</div>
                                            <small class="text-muted">@b.GuestCount Guests</small>
                                        </td>
                                        <td class="small">@b.EventDate.ToString("dd MMM yyyy")</td>
                                        <td class="fw-bold">₹@b.TotalAmount.ToString("N0")</td>
                                        <td>
                                            @switch (b.Status)
                                            {
                                                case "Confirmed":
                                                    <span class="badge-status-confirmed">Confirmed</span>
                                                    break;
                                                case "Pending":
                                                    <span class="badge-status-pending">Pending</span>
                                                    break;
                                                case "Completed":
                                                    <span class="badge-status-completed">Completed</span>
                                                    break;
                                                default:
                                                    <span class="badge-status-cancelled">Cancelled</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="pe-4 text-end">
                                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-royal btn-sm">
                                                Invoice
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Right Side: Profile & Quick Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-badge text-danger me-2"></i> Profile Details</h5>
                <ul class="list-unstyled small mb-0">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Full Name:</span>
                        <span class="fw-semibold">@Model.User.FullName</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <span class="fw-semibold">@Model.User.Email</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@Model.User.PhoneNumber</span>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted">Member Since:</span>
                        <span class="fw-semibold">@Model.User.CreatedAt.ToString("MMM yyyy")</span>
                    </li>
                </ul>
            </div>

            <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #faedd9, #fdf8f3); border: 1px solid rgba(197, 155, 39, 0.3);">
                <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-headset text-danger me-1"></i> Dedicated Concierge Desk</h6>
                <p class="small text-muted mb-3">Need to customize your itinerary or add special floral themes? Contact your dedicated coordinator directly.</p>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-royal btn-sm w-100">
                    <i class="bi bi-chat-dots me-1"></i> Message Concierge
                </a>
            </div>
        </div>
    </div>
</div>
