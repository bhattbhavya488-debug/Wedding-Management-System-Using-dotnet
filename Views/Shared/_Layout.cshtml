<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Royal Knot Wedding Management System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Wedding Luxury Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Contact Bar -->
    <div class="py-1 text-center text-white" style="background: linear-gradient(90deg, #2a0b17, #5a142e, #721c3b); font-size: 0.82rem; letter-spacing: 0.04em;">
        <span><i class="bi bi-geo-alt text-warning me-1"></i> Ahmedabad &bull; Udaipur &bull; Goa &bull; Mumbai</span>
        <span class="mx-3 opacity-50">|</span>
        <span><i class="bi bi-clock text-warning me-1"></i> Mon - Sat: 9:30 AM - 8:00 PM</span>
        <span class="mx-3 opacity-50">|</span>
        <span><i class="bi bi-telephone text-warning me-1"></i> +91 79 2685 4100</span>
        <span class="mx-3 opacity-50">|</span>
        <span><i class="bi bi-envelope text-warning me-1"></i> concierge@royalknotweddings.com</span>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg wedding-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-gem gold-icon"></i>
                    <span>Royal<span style="color: var(--accent-gold);">Knot</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#weddingNav" aria-controls="weddingNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="weddingNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Packages" asp-action="Index"><i class="bi bi-gift me-1"></i> Packages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Services"><i class="bi bi-magic me-1"></i> Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-1"></i> About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact"><i class="bi bi-envelope me-1"></i> Contact</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Panel
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-calendar-check me-2 text-success"></i> Manage Bookings</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Packages" asp-action="Create"><i class="bi bi-plus-circle me-2 text-warning"></i> Add New Package</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Customers"><i class="bi bi-people me-2 text-info"></i> Customer List</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Messages"><i class="bi bi-chat-left-text me-2 text-secondary"></i> Inquiries</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-royal btn-sm px-3">
                                    <i class="bi bi-person-circle me-1"></i> My Dashboard
                                </a>
                                <a asp-controller="Bookings" asp-action="Index" class="btn btn-royal btn-sm px-3">
                                    <i class="bi bi-calendar2-heart me-1"></i> My Bookings
                                </a>
                            }

                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle btn-sm rounded-pill px-3 border" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-fill text-muted me-1"></i> @User.Identity.Name
                                    <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "badge-gold") ms-1">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer me-2"></i> Admin Panel</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid me-2"></i> Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index"><i class="bi bi-journal-check me-2"></i> Bookings</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-royal btn-sm px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-gold btn-sm px-3">
                                <i class="bi bi-stars me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Banners -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5 align-middle"></i>
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main View Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Luxury Wedding Footer -->
    <footer class="wedding-footer mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="d-flex align-items-center gap-2">
                        <i class="bi bi-gem" style="color: var(--accent-gold);"></i> Royal Knot Weddings
                    </h5>
                    <p class="small text-white-50 mt-3">
                        Premier bespoke wedding planning and experiential design agency. Crafting majestic royal celebrations, intimate beach vows, and grand heritage destination weddings across India and beyond.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2" style="width: 38px; height: 38px;"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2" style="width: 38px; height: 38px;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2" style="width: 38px; height: 38px;"><i class="bi bi-pinterest"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2" style="width: 38px; height: 38px;"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled small mt-3 space-y-2">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Home</a></li>
                        <li class="mb-2"><a asp-controller="Packages" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Wedding Packages</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Services"><i class="bi bi-chevron-right me-1"></i> Services Catalog</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right me-1"></i> About Our Firm</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact"><i class="bi bi-chevron-right me-1"></i> Contact Concierge</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Experience Studios</h5>
                    <ul class="list-unstyled small mt-3 text-white-50">
                        <li class="mb-3">
                            <strong class="text-white d-block"><i class="bi bi-geo-alt text-warning me-1"></i> Ahmedabad Flagship</strong>
                            Royal Knot House, Sindhu Bhavan Road, Bodakdev, Ahmedabad 380054
                        </li>
                        <li class="mb-3">
                            <strong class="text-white d-block"><i class="bi bi-geo-alt text-warning me-1"></i> Udaipur Studio</strong>
                            Lake Pichola Promenade, Heritage District, Udaipur 313001
                        </li>
                        <li>
                            <strong class="text-white d-block"><i class="bi bi-geo-alt text-warning me-1"></i> Goa Coastal Studio</strong>
                            Candolim Beach Road, North Goa 403515
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Concierge Desk</h5>
                    <p class="small text-white-50 mt-3">
                        Have queries or ready to schedule your bridal walkthrough? Connect with our dedicated wedding managers today.
                    </p>
                    <div class="bg-black bg-opacity-25 p-3 rounded-3 border border-secondary border-opacity-25 small mt-3">
                        <div class="text-white mb-1"><i class="bi bi-telephone-inbound text-warning me-2"></i> +91 79 2685 4100</div>
                        <div class="text-white mb-1"><i class="bi bi-whatsapp text-success me-2"></i> +91 98765 43210</div>
                        <div class="text-white-50"><i class="bi bi-envelope text-warning me-2"></i> inquiries@royalknotweddings.com</div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    &copy; 2026 <strong>Royal Knot Weddings Pvt. Ltd.</strong> All rights reserved.
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-white-50">Terms & Conditions</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
