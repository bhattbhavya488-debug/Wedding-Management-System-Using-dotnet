@model WeddingManagementSystem.Models.WeddingPackage
@{
    ViewData["Title"] = Model.Name + " - Package Details";
    var featureList = Model.Features?.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? Array.Empty<string>();
}

<div class="py-5" style="background: linear-gradient(135deg, #fdf2f4, #fff9f0); border-bottom: 1px solid rgba(197, 155, 39, 0.2);">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-3">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Packages</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge badge-gold px-3 py-1 mb-2">@Model.Category Signature Collection</span>
                <h1 class="display-5 fw-bold mb-3">@Model.Name</h1>
                <div class="d-flex flex-wrap gap-4 text-muted">
                    <span><i class="bi bi-people-fill text-danger me-1"></i> Guest Capacity: <strong>@Model.GuestCapacity People</strong></span>
                    <span><i class="bi bi-tag-fill text-warning me-1"></i> Category: <strong>@Model.Category</strong></span>
                    <span><i class="bi bi-shield-check text-success me-1"></i> 100% Guaranteed Execution</span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="p-3 bg-white rounded-4 shadow-sm border border-warning d-inline-block text-center">
                    <span class="small text-muted d-block">All-Inclusive Investment</span>
                    <span class="display-6 fw-bold text-danger">₹@Model.Price.ToString("N0")</span>
                    <small class="text-muted d-block">(Includes all ceremonial services & taxes)</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Left: Image and Description -->
        <div class="col-lg-7">
            <div class="rounded-4 overflow-hidden shadow-sm border mb-4">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100" style="max-height: 450px; object-fit: cover;" />
            </div>

            <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                <h4 class="fw-bold mb-3">Package Experience Overview</h4>
                <p class="text-muted lead fs-6">
                    @Model.Description
                </p>
                <p class="text-muted small">
                    This package is meticulously curated by Royal Knot's premier master planners to give you and your families a tranquil, magnificent wedding festival without worrying about logistics, vendor delays, or unforeseen expenses.
                </p>
            </div>

            <div class="bg-white p-4 rounded-4 shadow-sm border">
                <h4 class="fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i> Included Services & Amenities</h4>
                <div class="row g-3">
                    @foreach (var feature in featureList)
                    {
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border d-flex align-items-start gap-2 h-100">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0 mt-1"></i>
                                <span class="small fw-semibold text-dark">@feature</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Booking Callout Card -->
        <div class="col-lg-5">
            <div class="sticky-top" style="top: 100px;">
                <div class="card border-0 shadow-lg rounded-4 p-4" style="background: #ffffff; border: 1.5px solid rgba(197, 155, 39, 0.35) !important;">
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="text-center mb-4 pb-3 border-bottom">
                            <span class="badge bg-danger px-3 py-1 mb-2"><i class="bi bi-shield-lock-fill me-1"></i> Administrator View</span>
                            <h4 class="fw-bold">Package Management</h4>
                            <p class="text-muted small mb-0">You are viewing this package with administrative privileges.</p>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Package ID:</span>
                                <span class="fw-bold">#PKG-@Model.Id</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Catalog Status:</span>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active & Public" : "Draft / Hidden")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Category:</span>
                                <span class="fw-bold">@Model.Category Wedding</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Listed Price:</span>
                                <span class="fw-bold text-danger">₹@Model.Price.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between small pt-2 border-top">
                                <span class="text-muted">Guest Capacity:</span>
                                <span class="fw-bold">@Model.GuestCapacity Persons</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-royal btn-lg shadow">
                                <i class="bi bi-pencil-square me-2"></i> Edit Package Details
                            </a>
                            <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-secondary">
                                <i class="bi bi-calendar2-check me-2"></i> View Client Bookings
                            </a>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to deactivate this package?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-trash me-1"></i> Deactivate Package
                                </button>
                            </form>
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-light border text-muted btn-sm mt-2">
                                <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4 pb-3 border-bottom">
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 mb-2">Instant Online Booking</span>
                            <h4 class="fw-bold">Reserve This Wedding Package</h4>
                            <p class="text-muted small mb-0">Select your wedding date and expected guest count to initiate your booking.</p>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Starting Package Base Price:</span>
                                <span class="fw-bold">₹@Model.Price.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Maximum Guest Limit:</span>
                                <span class="fw-bold">@Model.GuestCapacity Guests</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Dedicated Wedding Coordinator:</span>
                                <span class="text-success fw-bold">Included Free</span>
                            </div>
                            <div class="d-flex justify-content-between small pt-2 border-top">
                                <span class="fw-bold">Total Payable:</span>
                                <span class="fw-bold text-danger fs-5">₹@Model.Price.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Bookings" asp-action="Create" asp-route-packageId="@Model.Id" class="btn btn-royal btn-lg shadow">
                                <i class="bi bi-calendar2-check-fill me-2"></i> Book This Package Now
                            </a>
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary">
                                <i class="bi bi-telephone me-2"></i> Request Custom Quotation
                            </a>
                        </div>

                        <div class="mt-4 pt-3 border-top text-center">
                            <small class="text-muted">
                                <i class="bi bi-lock-fill text-warning me-1"></i> Free rescheduling up to 30 days before the wedding date.
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
