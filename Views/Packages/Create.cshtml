@model WeddingManagementSystem.Models.WeddingPackage
@{
    ViewData["Title"] = "Add New Wedding Package - Admin";
}

<div class="py-4 bg-white border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-2">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin Panel</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Packages</a></li>
                <li class="breadcrumb-item active" aria-current="page">New Package</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle text-danger me-2"></i> Create New Wedding Package</h2>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold">Package Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Royal Palace Heritage Wedding" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select asp-for="Category" class="form-select">
                                <option value="Royal">Royal</option>
                                <option value="Beach">Beach</option>
                                <option value="Destination">Destination</option>
                                <option value="Traditional">Traditional</option>
                                <option value="Minimalist">Minimalist</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Price (₹) <span class="text-danger">*</span></label>
                            <input asp-for="Price" type="number" step="any" min="1000" class="form-control" placeholder="850000" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuestCapacity" class="form-label fw-semibold">Maximum Guest Capacity <span class="text-danger">*</span></label>
                            <input asp-for="GuestCapacity" type="number" step="1" min="10" class="form-control" placeholder="500" />
                            <span asp-validation-for="GuestCapacity" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            <small class="text-muted">Direct image URL from Unsplash or web</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Package Description <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the themes, ceremony flow, dining experience..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Features" class="form-label fw-semibold">Features (Separate with Semicolons ';')</label>
                            <textarea asp-for="Features" rows="3" class="form-control" placeholder="Royal Floral Mandap; 5-Star Multi-Cuisine Catering; Cinematic 4K Drone Film; Live Shehnai Band"></textarea>
                            <span asp-validation-for="Features" class="text-danger small"></span>
                            <small class="text-muted">Separate each feature with a semicolon so it displays neatly as a checklist.</small>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel & Back
                            </a>
                            <button type="submit" class="btn btn-royal px-4">
                                <i class="bi bi-check2-circle me-1"></i> Save Package
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
