@model WeddingManagementSystem.Models.ViewModels.PackageFilterViewModel
@{
    ViewData["Title"] = "Wedding Packages & Collections";
}

<div class="py-5 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge badge-gold px-3 py-1 mb-2">Exquisite Choices</span>
                <h1 class="display-6 fw-bold mb-1">Wedding Packages Catalog</h1>
                <p class="text-muted mb-0">Discover tailor-made royal, beach, destination, and traditional packages.</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-3 mt-md-0">
                    <a asp-action="Create" class="btn btn-royal">
                        <i class="bi bi-plus-circle me-1"></i> Add New Package
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Filter and Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background: #fffcf8; border: 1px solid rgba(197, 155, 39, 0.2) !important;">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search Packages</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, theme, features..." />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Theme / Category</label>
                <select name="selectedCategory" class="form-select">
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.SelectedCategory == cat)
                        {
                            <option value="@cat" selected>@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Sort By</label>
                <select name="sortBy" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Default (Name)</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="capacity_desc" selected="@(Model.SortBy == "capacity_desc")">Guest Capacity: Highest</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-royal flex-fill">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Packages Grid -->
    @if (!Model.Packages.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="bi bi-search text-muted display-3 mb-3"></i>
            <h4>No wedding packages found</h4>
            <p class="text-muted">Try adjusting your search criteria or category filter.</p>
            <a asp-action="Index" class="btn btn-outline-royal">View All Packages</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var package in Model.Packages)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="wedding-card">
                        <div class="card-img-wrapper">
                            <img src="@package.ImageUrl" alt="@package.Name" loading="lazy" />
                            <span class="card-category-badge">@package.Category</span>
                            <span class="card-price-tag">₹@package.Price.ToString("N0")</span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="heading-serif mb-0" style="font-size: 1.3rem;">@package.Name</h4>
                            </div>

                            <p class="text-muted small mb-3 flex-grow-1">
                                @(package.Description.Length > 110 ? package.Description.Substring(0, 107) + "..." : package.Description)
                            </p>

                            <!-- Features Pill Preview -->
                            @if (!string.IsNullOrEmpty(package.Features))
                            {
                                var feats = package.Features.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                <div class="mb-3">
                                    <ul class="list-unstyled small text-muted mb-0">
                                        @foreach (var f in feats.Take(3))
                                        {
                                            <li class="mb-1 text-truncate"><i class="bi bi-check-circle-fill text-warning me-1"></i> @f</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <div class="d-flex justify-content-between text-muted small py-2 border-top border-bottom mb-3">
                                <span><i class="bi bi-people-fill text-danger me-1"></i> Up to <strong>@package.GuestCapacity Guests</strong></span>
                                <span class="text-success"><i class="bi bi-shield-check me-1"></i> All Inclusive</span>
                            </div>

                            <div class="d-grid gap-2">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Details" asp-route-id="@package.Id" class="btn btn-outline-royal btn-sm">
                                        <i class="bi bi-eye me-1"></i> View Full Specifications
                                    </a>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@package.Id" class="btn btn-royal btn-sm flex-fill">
                                            <i class="bi bi-pencil-square me-1"></i> Edit Package
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@package.Id" method="post" class="flex-fill" onsubmit="return confirm('Are you sure you want to deactivate this package?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@package.Id" class="btn btn-outline-royal btn-sm">
                                        <i class="bi bi-eye me-1"></i> View Full Package Details
                                    </a>
                                    <a asp-controller="Bookings" asp-action="Create" asp-route-packageId="@package.Id" class="btn btn-royal btn-sm">
                                        <i class="bi bi-calendar2-heart me-1"></i> Book This Package
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
