@model IEnumerable<WeddingManagementSystem.Models.Booking>
@{
    ViewData["Title"] = "My Wedding Bookings";
}

<div class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge badge-gold px-3 py-1 mb-2">Reservation History</span>
                <h2 class="fw-bold mb-1">My Wedding Bookings</h2>
                <p class="text-muted small mb-0">Track the status, dates, and invoice receipts of your wedding celebrations.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Packages" asp-action="Index" class="btn btn-royal">
                    <i class="bi bi-plus-circle me-1"></i> Book Another Package
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="bi bi-calendar-x text-muted display-3 mb-3"></i>
            <h4>No bookings placed yet</h4>
            <p class="text-muted">You haven't reserved any wedding package so far. Explore our packages to begin.</p>
            <a asp-controller="Packages" asp-action="Index" class="btn btn-royal">Browse Wedding Packages</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Booking #</th>
                            <th>Package</th>
                            <th>Wedding Date</th>
                            <th>Guests</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Booked On</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-danger">
                                        @item.BookingNumber
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(item.Package?.Name ?? "Custom Package")</div>
                                    <small class="text-muted">@(item.Package?.Category ?? "Custom") Wedding</small>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event text-danger me-1"></i>
                                    <strong>@item.EventDate.ToString("dd MMM yyyy")</strong>
                                </td>
                                <td>
                                    <i class="bi bi-people text-muted me-1"></i> @item.GuestCount
                                </td>
                                <td class="fw-bold text-dark">
                                    ₹@item.TotalAmount.ToString("N0")
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Confirmed":
                                            <span class="badge-status-confirmed"><i class="bi bi-check-circle-fill me-1"></i> Confirmed</span>
                                            break;
                                        case "Pending":
                                            <span class="badge-status-pending"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                                            break;
                                        case "Completed":
                                            <span class="badge-status-completed"><i class="bi bi-patch-check-fill me-1"></i> Completed</span>
                                            break;
                                        default:
                                            <span class="badge-status-cancelled"><i class="bi bi-x-circle-fill me-1"></i> Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">
                                    @item.BookingDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (item.Status == "Pending")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancel Booking">
                                                    <i class="bi bi-x-lg"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
