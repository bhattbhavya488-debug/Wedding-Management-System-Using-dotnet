@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 shadow-sm border border-danger border-opacity-25">
                <i class="bi bi-shield-lock-fill text-danger display-1 mb-3"></i>
                <h2 class="fw-bold text-danger">Access Restricted</h2>
                <p class="text-muted mt-2 mb-4">
                    You do not have administrative privileges to access this page. Please sign in with an Administrator account to continue.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-1"></i> Back to Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-royal">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In as Admin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
