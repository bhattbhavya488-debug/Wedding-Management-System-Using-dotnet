@using WeddingManagementSystem.Models
@{
    ViewData["Title"] = "Crafting Your Unforgettable Dream Wedding";
    var featuredPackages = ViewBag.FeaturedPackages as List<WeddingPackage> ?? new List<WeddingPackage>();
    var services = ViewBag.Services as List<ServiceItem> ?? new List<ServiceItem>();
}

<!-- Hero Section -->
<section class="hero-banner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge badge-gold px-3 py-2 mb-3">
                    <i class="bi bi-stars me-1"></i> Premier Luxury Wedding Planners
                </span>
                <h1 class="hero-title">
                    Where Royal Elegance Meets <span>Your Eternal Love</span>
                </h1>
                <p class="hero-subtitle">
                    From majestic palace mandaps to sun-kissed beach vows, we curate breathtaking, bespoke wedding experiences with flawless execution and timeless Indian grandeur.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Packages" asp-action="Index" class="btn btn-gold btn-lg px-4 shadow">
                        <i class="bi bi-gift-fill me-2"></i> Explore Wedding Packages
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-calendar-heart me-2"></i> Plan Consultation
                    </a>
                </div>
            </div>
            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="hero-stats-card">
                    <h4 class="brand-font mb-4 text-warning border-bottom border-warning border-opacity-25 pb-2">
                        <i class="bi bi-trophy me-2"></i> Our Celebrated Milestone
                    </h4>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="stat-number">@(ViewBag.TotalWeddingsCount)+</div>
                            <div class="stat-label">Weddings Curated</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-number">@(ViewBag.TotalHappyCouples)+</div>
                            <div class="stat-label">Happy Couples</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-number">50+</div>
                            <div class="stat-label">Luxury Venues</div>
                        </div>
                        <div class="col-6">
                            <div class="stat-number">99.8%</div>
                            <div class="stat-label">Five Star Reviews</div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top border-white border-opacity-25 text-center">
                        <small class="text-white-50"><i class="bi bi-shield-check text-warning me-1"></i> Certified Luxury Wedding Planning & Event Production Agency</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Highlights -->
<section class="py-5" style="background: #ffffff; border-bottom: 1px solid rgba(197, 155, 39, 0.15);">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <i class="bi bi-palette-fill fs-1 text-danger"></i>
                    <h6 class="fw-bold mt-3 mb-1">Bespoke Themes</h6>
                    <p class="small text-muted mb-0">Customized royal, beach, and floral decor concepts.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <i class="bi bi-cash-stack fs-1 text-warning"></i>
                    <h6 class="fw-bold mt-3 mb-1">Transparent Pricing</h6>
                    <p class="small text-muted mb-0">Clear itemized packages with zero hidden expenses.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <i class="bi bi-person-hearts fs-1 text-danger"></i>
                    <h6 class="fw-bold mt-3 mb-1">Dedicated Concierge</h6>
                    <p class="small text-muted mb-0">Personal wedding planner from day one till Bidaai.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <i class="bi bi-award-fill fs-1 text-warning"></i>
                    <h6 class="fw-bold mt-3 mb-1">Verified Vendors</h6>
                    <p class="small text-muted mb-0">Elite 5-star caterers, artists, and photographers.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Packages -->
<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <span class="badge badge-gold px-3 py-1 mb-2">Signature Collections</span>
                <h2 class="display-6 fw-bold">Featured Wedding Packages</h2>
                <p class="text-muted mb-0">All-inclusive luxury wedding experiences designed for perfection.</p>
            </div>
            <a asp-controller="Packages" asp-action="Index" class="btn btn-outline-royal rounded-pill mt-3 mt-md-0">
                View All Packages <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var package in featuredPackages)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="wedding-card">
                        <div class="card-img-wrapper">
                            <img src="@package.ImageUrl" alt="@package.Name" loading="lazy" />
                            <span class="card-category-badge">@package.Category Wedding</span>
                            <span class="card-price-tag">₹@package.Price.ToString("N0")</span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <h4 class="heading-serif mb-2" style="font-size: 1.35rem;">@package.Name</h4>
                            <p class="text-muted small mb-3 flex-grow-1">
                                @(package.Description.Length > 120 ? package.Description.Substring(0, 117) + "..." : package.Description)
                            </p>
                            
                            <div class="d-flex justify-content-between text-muted small py-2 border-top border-bottom mb-3">
                                <span><i class="bi bi-people-fill text-danger me-1"></i> Capacity: <strong>@package.GuestCapacity Guests</strong></span>
                                <span><i class="bi bi-check-circle-fill text-success me-1"></i> Full Concierge</span>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-controller="Packages" asp-action="Details" asp-route-id="@package.Id" class="btn btn-outline-royal btn-sm">
                                    <i class="bi bi-eye me-1"></i> View Details & Features
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Packages" asp-action="Edit" asp-route-id="@package.Id" class="btn btn-royal btn-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Manage / Edit Package
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Bookings" asp-action="Create" asp-route-packageId="@package.Id" class="btn btn-royal btn-sm">
                                        <i class="bi bi-calendar-check me-1"></i> Book This Package
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Core Services Showcase -->
<section class="py-5" style="background: #fbf5ef;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge badge-gold px-3 py-1 mb-2">Complete Wedding Solutions</span>
            <h2 class="display-6 fw-bold">Our Curated Wedding Services</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Every subtle touch is planned with passion. From ceremonial floral rituals to gastronomical feasts and celebrity entertainment.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var s in services)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="service-card">
                        <div class="service-icon-box">
                            <i class="bi @s.IconClass"></i>
                        </div>
                        <h5 class="fw-bold mb-2">@s.Name</h5>
                        <span class="badge bg-light text-dark border mb-3">@s.Category</span>
                        <p class="text-muted small mb-3">@s.Description</p>
                        <div class="fw-bold text-danger">
                            Starts from ₹@s.StartingPrice.ToString("N0")
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="Services" class="btn btn-royal px-4">
                <i class="bi bi-grid-fill me-2"></i> Explore Complete Services Catalog
            </a>
        </div>
    </div>
</section>

<!-- Couple Testimonials -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge badge-gold px-3 py-1 mb-2">Stories of Eternal Love</span>
            <h2 class="display-6 fw-bold">Words from Our Happy Couples</h2>
            <p class="text-muted">Real couples who trusted Royal Knot for their once-in-a-lifetime journey.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 border h-100 shadow-sm" style="background: #fffcf8; border-color: rgba(197, 155, 39, 0.25) !important;">
                    <div class="text-warning mb-3">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="fst-italic text-muted">
                        "The Royal Heritage Palace package was surreal! Every guest was spellbound by the floral mandap and the seamless hospitality. Our coordinator took care of every tiny detail."
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px;">
                            P&R
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Priya & Rohit Singhania</h6>
                            <small class="text-muted">Udaipur Palace Wedding</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-4 border h-100 shadow-sm" style="background: #fffcf8; border-color: rgba(197, 155, 39, 0.25) !important;">
                    <div class="text-warning mb-3">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="fst-italic text-muted">
                        "Our Sunset Beachfront ceremony in Goa was straight out of a dream movie. The catering was heavenly, and the drone photography team captured timeless moments."
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px;">
                            A&K
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Ananya & Kabir Mehta</h6>
                            <small class="text-muted">Beachfront Wedding Goa</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-4 border h-100 shadow-sm" style="background: #fffcf8; border-color: rgba(197, 155, 39, 0.25) !important;">
                    <div class="text-warning mb-3">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <p class="fst-italic text-muted">
                        "The Traditional Vedic Vivah was authentic and spiritual. Pure marigold themes and classical musicians brought so much warmth. Highly recommended!"
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px;">
                            D&V
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Divya & Varun Patel</h6>
                            <small class="text-muted">Ahmedabad Heritage Wedding</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 text-white" style="background: linear-gradient(135deg, #4a0d24, #721c3b);">
    <div class="container text-center py-4">
        <span class="badge badge-gold px-3 py-1 mb-3">Your Journey Starts Here</span>
        <h2 class="display-5 fw-bold text-white mb-3">Ready to Plan Your Dream Wedding?</h2>
        <p class="lead text-white-50 mx-auto mb-4" style="max-width: 650px;">
            Book an appointment with our wedding concierge or explore our customized packages tailored to your budget and guest count.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Packages" asp-action="Index" class="btn btn-gold btn-lg px-4">
                <i class="bi bi-gift me-2"></i> Browse All Packages
            </a>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-chat-heart me-2"></i> Talk to a Planner
            </a>
        </div>
    </div>
</section>
