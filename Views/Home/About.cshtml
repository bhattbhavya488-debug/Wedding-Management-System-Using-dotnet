@{
    ViewData["Title"] = "About Us - Royal Knot Weddings";
}

<div class="py-5 bg-white border-bottom">
    <div class="container text-center">
        <span class="badge badge-gold px-3 py-1 mb-2">Our Story & Legacy</span>
        <h1 class="display-5 fw-bold">About Royal Knot Weddings</h1>
        <p class="lead text-muted mx-auto" style="max-width: 650px;">
            A premier bespoke wedding planning and production house, curating timeless royal, destination, and beach celebrations with architectural elegance and bespoke flair.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 mb-3">Our Mission</span>
            <h2 class="display-6 fw-bold mb-4">Transforming Wedding Dreams into Royal Realities</h2>
            <p class="text-muted">
                Indian weddings are a harmonious union of traditions, rituals, families, and emotional milestones. <strong>Royal Knot</strong> was conceived to solve the chaos and stress of modern wedding planning by bringing transparency, curated packages, certified vendors, and end-to-end digital tracking to the fingertips of couples.
            </p>
            <p class="text-muted">
                Whether you envision a grand royal celebration at a heritage palace in Rajasthan, a serene sunset mandap in Goa, or an auspicious Vedic ceremony in Ahmedabad, our platform bridges the gap between vision and immaculate execution.
            </p>

            <div class="row g-3 mt-4">
                <div class="col-sm-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <i class="bi bi-patch-check-fill text-warning fs-3 mb-2"></i>
                        <h6 class="fw-bold">100% Quality Assurance</h6>
                        <p class="small text-muted mb-0">Every vendor is vetted for hygiene, pedigree, and punctuality.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border rounded-3 bg-white">
                        <i class="bi bi-clock-history text-danger fs-3 mb-2"></i>
                        <h6 class="fw-bold">On-Time Execution</h6>
                        <p class="small text-muted mb-0">Zero delays in ceremonies, food service, or ritual setups.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="position-relative">
                <img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=800&q=80" alt="Royal Wedding" class="img-fluid rounded-4 shadow-lg border border-warning border-opacity-50" />
                <div class="position-absolute bottom-0 start-0 m-4 p-4 bg-white rounded-3 shadow border" style="max-width: 280px;">
                    <h5 class="fw-bold text-danger mb-1">500+ Couples</h5>
                    <p class="small text-muted mb-0">Have commenced their happily ever after with Royal Knot.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Standards & Accolades -->
    <div class="mt-5 p-4 rounded-4 bg-white border border-warning border-opacity-25 shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                <i class="bi bi-award-fill text-warning display-4"></i>
            </div>
            <div class="col-md-10">
                <h5 class="fw-bold mb-1">Our Heritage & Professional Standards</h5>
                <p class="small text-muted mb-2">
                    Operating out of our flagship experience studios in Ahmedabad, Udaipur, and Goa, Royal Knot Weddings delivers bespoke event architecture, certified catering hygiene, and end-to-end luxury hospitality management.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i> Bespoke Event Architecture</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i> ISO 9001:2015 Hospitality Protocols</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i> Certified 5-Star Culinary Partners</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i> End-to-End Client Discretion</span>
                    <span class="badge bg-light text-dark border"><i class="bi bi-check-circle-fill text-success me-1"></i> Pan-India Destination Network</span>
                </div>
            </div>
        </div>
    </div>
</div>
