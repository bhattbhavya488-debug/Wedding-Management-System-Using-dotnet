@model WeddingManagementSystem.Models.ContactMessage
@{
    ViewData["Title"] = "Contact Wedding Concierge";
}

<div class="py-5 bg-white border-bottom">
    <div class="container text-center">
        <span class="badge badge-gold px-3 py-1 mb-2">Connect With Us</span>
        <h1 class="display-5 fw-bold">Let's Plan Something Extraordinary</h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">
            Have questions about wedding packages, custom themes, or availability? Our wedding concierge team is here to assist you.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border border-secondary border-opacity-10">
                <h3 class="fw-bold mb-3">Send Us an Inquiry</h3>
                <p class="text-muted small mb-4">Fill out the form below, and our wedding planners will call you back within 24 hours.</p>

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Priya Sharma" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="priya@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Ceremony Type <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Destination Wedding in Udaipur" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label fw-semibold">Your Message / Expectations <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" rows="5" class="form-control" placeholder="Tell us about your estimated dates, guest count, and dream theme..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-royal btn-lg px-4 shadow">
                                <i class="bi bi-send-fill me-2"></i> Submit Inquiry
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contact Information Cards -->
        <div class="col-lg-5">
            <div class="p-4 rounded-4 bg-white shadow-sm border mb-4">
                <h4 class="fw-bold mb-4">Head Concierge Office</h4>

                <div class="d-flex gap-3 mb-4">
                    <div class="service-icon-box m-0" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Office Location</h6>
                        <p class="small text-muted mb-0">Royal Knot Heritage Tower, S.G. Highway, Ahmedabad, Gujarat 380054</p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="service-icon-box m-0" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-telephone-fill text-success"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Direct Phone & WhatsApp</h6>
                        <p class="small text-muted mb-0">+91 98765 43210 / +91 91234 56780</p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="service-icon-box m-0" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-envelope-open-fill text-warning"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Official Email</h6>
                        <p class="small text-muted mb-0">concierge@royalknotweddings.com</p>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="service-icon-box m-0" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-clock-fill text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Concierge Hours</h6>
                        <p class="small text-muted mb-0">Monday – Saturday: 10:00 AM – 8:00 PM IST</p>
                    </div>
                </div>
            </div>

            <!-- Private Consultations Card -->
            <div class="p-4 rounded-4 border bg-white shadow-sm" style="border-color: rgba(197, 155, 39, 0.35) !important;">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-calendar-heart text-danger me-2"></i> Private Bridal Consultations</h6>
                <p class="small text-muted mb-2">
                    In-person appointments are hosted at our Ahmedabad, Udaipur, and Goa experience studios. Virtual consultations are also offered for destination weddings and NRI families worldwide.
                </p>
                <div class="small text-muted">
                    <i class="bi bi-shield-check text-success me-1"></i> Strict confidentiality and dedicated single-point coordination.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
