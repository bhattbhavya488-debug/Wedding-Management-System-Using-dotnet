@model IEnumerable<WeddingManagementSystem.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings - Admin Portal";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-1">
                        <li class="breadcrumb-item"><a asp-action="Index">Admin Panel</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Manage Bookings</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">Manage Wedding Bookings</h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Status Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Bookings" asp-route-status="All" class="btn btn-sm @(currentStatus == "All" ? "btn-dark" : "btn-outline-dark")">
            All Bookings
        </a>
        <a asp-action="Bookings" asp-route-status="Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning" : "btn-outline-warning text-dark")">
            Pending
        </a>
        <a asp-action="Bookings" asp-route-status="Confirmed" class="btn btn-sm @(currentStatus == "Confirmed" ? "btn-success" : "btn-outline-success")">
            Confirmed
        </a>
        <a asp-action="Bookings" asp-route-status="Completed" class="btn btn-sm @(currentStatus == "Completed" ? "btn-primary" : "btn-outline-primary")">
            Completed
        </a>
        <a asp-action="Bookings" asp-route-status="Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-danger" : "btn-outline-danger")">
            Cancelled
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border">
            <i class="bi bi-calendar-x text-muted display-4 mb-3"></i>
            <h5>No bookings found matching filter '@currentStatus'</h5>
            <a asp-action="Bookings" asp-route-status="All" class="btn btn-outline-dark btn-sm mt-2">Clear Filter</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small">
                        <tr>
                            <th class="ps-4">Booking #</th>
                            <th>Customer Info</th>
                            <th>Package Name</th>
                            <th>Event Date</th>
                            <th>Guests</th>
                            <th>Total (₹)</th>
                            <th>Status Action</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-danger">@b.BookingNumber</td>
                                <td>
                                    <div class="fw-semibold">@(b.User?.FullName ?? "N/A")</div>
                                    <small class="text-muted"><i class="bi bi-envelope me-1"></i>@(b.User?.Email ?? "")</small><br />
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(b.User?.PhoneNumber ?? "")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(b.Package?.Name ?? "Package")</div>
                                    <span class="badge bg-light text-dark border">@(b.Package?.Category ?? "Custom")</span>
                                </td>
                                <td class="small">
                                    <i class="bi bi-calendar2-heart text-danger me-1"></i>
                                    <strong>@b.EventDate.ToString("dd MMM yyyy")</strong>
                                </td>
                                <td>@b.GuestCount</td>
                                <td class="fw-bold">₹@b.TotalAmount.ToString("N0")</td>
                                <td>
                                    <form asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <select name="status" class="form-select form-select-sm" style="width: 130px;" onchange="this.form.submit()">
                                            <option value="Pending" selected="@(b.Status == "Pending")">Pending</option>
                                            <option value="Confirmed" selected="@(b.Status == "Confirmed")">Confirmed</option>
                                            <option value="Completed" selected="@(b.Status == "Completed")">Completed</option>
                                            <option value="Cancelled" selected="@(b.Status == "Cancelled")">Cancelled</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-secondary btn-sm" title="View Full Invoice">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
