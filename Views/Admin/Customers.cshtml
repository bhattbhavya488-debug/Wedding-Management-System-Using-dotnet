@model IEnumerable<WeddingManagementSystem.Models.User>
@{
    ViewData["Title"] = "Customer Directory - Admin";
}

<div class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-1">
                        <li class="breadcrumb-item"><a asp-action="Index">Admin Panel</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Customers</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">Registered Customers</h2>
                <p class="text-muted small mb-0">List of all registered couple accounts and their lifetime booking spend.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small">
                    <tr>
                        <th class="ps-4">Customer Name</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Joined On</th>
                        <th>Total Bookings</th>
                        <th>Lifetime Spend (₹)</th>
                        <th class="pe-4 text-end">Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        var totalSpent = customer.Bookings.Where(b => b.Status != "Cancelled").Sum(b => b.TotalAmount);
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        @(customer.FullName.Length > 0 ? customer.FullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold">@customer.FullName</div>
                                        <small class="text-muted">ID: #CUS-@customer.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <i class="bi bi-envelope text-muted me-1"></i> @customer.Email
                            </td>
                            <td>
                                <i class="bi bi-telephone text-muted me-1"></i> @customer.PhoneNumber
                            </td>
                            <td class="small text-muted">
                                @customer.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-journal-bookmark me-1"></i> @customer.Bookings.Count Bookings
                                </span>
                            </td>
                            <td class="fw-bold text-success">
                                ₹@totalSpent.ToString("N0")
                            </td>
                            <td class="pe-4 text-end">
                                <span class="badge badge-gold">Customer</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
