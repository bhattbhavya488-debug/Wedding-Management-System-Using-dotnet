@model WeddingManagementSystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Center - Royal Knot";
}

<div class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger px-3 py-1 mb-2"><i class="bi bi-shield-lock-fill me-1"></i> Administrator Portal</span>
                <h2 class="fw-bold mb-1">Wedding Operations Dashboard</h2>
                <p class="text-muted small mb-0">System metrics, real-time booking management, customer tracking & REST API.</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Packages" asp-action="Create" class="btn btn-royal btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Package
                </a>
                <a href="/swagger" target="_blank" class="btn btn-outline-warning btn-sm text-dark">
                    <i class="bi bi-code-slash me-1"></i> Swagger API
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- KPI Statistic Widgets -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-royal">
                    <i class="bi bi-journal-album"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalBookings</div>
                    <div class="text-muted small">Total Bookings</div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-gold">
                    <i class="bi bi-hourglass-bottom"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-warning">@Model.PendingBookings</div>
                    <div class="text-muted small">Pending Approvals</div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-green">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-success text-truncate">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="text-muted small">Total Booking Value</div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-widget">
                <div class="stat-widget-icon icon-blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-primary">@Model.TotalCustomers</div>
                    <div class="text-muted small">Registered Customers</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Tabs -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Bookings" class="btn btn-outline-royal btn-sm px-3">
            <i class="bi bi-calendar-check me-1"></i> All Bookings (@Model.TotalBookings)
        </a>
        <a asp-action="Customers" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-people me-1"></i> Customer Directory (@Model.TotalCustomers)
        </a>
        <a asp-controller="Packages" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-gift me-1"></i> Active Packages (@Model.TotalPackages)
        </a>
        <a asp-action="Messages" class="btn btn-outline-secondary btn-sm px-3 position-relative">
            <i class="bi bi-envelope me-1"></i> Inquiries
            @if (Model.UnreadMessages > 0)
            {
                <span class="badge bg-danger rounded-pill ms-1">@Model.UnreadMessages</span>
            }
        </a>
    </div>

    <!-- Recent Bookings Table with Quick Status Changer -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-danger me-2"></i> Recent Bookings & Approvals</h5>
            <a asp-action="Bookings" class="btn btn-outline-secondary btn-sm">View All Bookings</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small">
                    <tr>
                        <th class="ps-4">Booking #</th>
                        <th>Customer</th>
                        <th>Package</th>
                        <th>Event Date</th>
                        <th>Total</th>
                        <th>Current Status</th>
                        <th>Update Status</th>
                        <th class="pe-4 text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="text-danger text-decoration-none">
                                    @booking.BookingNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@(booking.User?.FullName ?? "Unknown")</div>
                                <small class="text-muted">@(booking.User?.PhoneNumber ?? "")</small>
                            </td>
                            <td>
                                <div class="fw-semibold small">@(booking.Package?.Name ?? "Package")</div>
                                <small class="text-muted">@booking.GuestCount Guests</small>
                            </td>
                            <td class="small">
                                <strong>@booking.EventDate.ToString("dd MMM yyyy")</strong>
                            </td>
                            <td class="fw-bold small">
                                ₹@booking.TotalAmount.ToString("N0")
                            </td>
                            <td>
                                @switch (booking.Status)
                                {
                                    case "Confirmed":
                                        <span class="badge-status-confirmed">Confirmed</span>
                                        break;
                                    case "Pending":
                                        <span class="badge-status-pending">Pending</span>
                                        break;
                                    case "Completed":
                                        <span class="badge-status-completed">Completed</span>
                                        break;
                                    default:
                                        <span class="badge-status-cancelled">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                <form asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@booking.Id" />
                                    <select name="status" class="form-select form-select-sm" style="width: 120px;" onchange="this.form.submit()">
                                        <option value="Pending" selected="@(booking.Status == "Pending")">Pending</option>
                                        <option value="Confirmed" selected="@(booking.Status == "Confirmed")">Confirmed</option>
                                        <option value="Completed" selected="@(booking.Status == "Completed")">Completed</option>
                                        <option value="Cancelled" selected="@(booking.Status == "Cancelled")">Cancelled</option>
                                    </select>
                                </form>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-outline-secondary btn-sm" title="View Full Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
